{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hyungchulc/memory-forest/blob/main/docs/daily-plan.schema.json",
  "title": "Memory Forest Daily Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "forest_id",
    "transaction_id",
    "date",
    "entries",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "memory-forest-daily-plan-v1"
    },
    "forest_id": {
      "$ref": "#/$defs/forest_id"
    },
    "transaction_id": {
      "$ref": "#/$defs/hash"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "entries": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "source_record_ids",
          "summary"
        ],
        "properties": {
          "entry_id": {
            "$ref": "#/$defs/identifier"
          },
          "source_record_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_sha256",
        "result_sha256",
        "batch_id"
      ],
      "properties": {
        "packet_sha256": {
          "$ref": "#/$defs/hash"
        },
        "result_sha256": {
          "$ref": "#/$defs/hash"
        },
        "batch_id": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  },
  "$defs": {
    "forest_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
